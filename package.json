{
  "name": "poza-nuta",
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:import:karafun": "node --experimental-strip-types src/db/import-karafun-csv.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --experimental-strip-types src/db/seed.ts",
    "db:seed:operator": "node --experimental-strip-types src/db/seed-operator.ts",
    "db:link:operator-auth": "node --experimental-strip-types src/db/link-operator-auth.ts",
    "db:studio": "drizzle-kit studio",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
