{
  "name": "poza-nuta",
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:import:karafun": "node --experimental-strip-types src/db/import-karafun-csv.ts",
    "db:import:ising": "node --experimental-strip-types src/db/import-ising.ts",
    "import-worker": "node --experimental-strip-types src/server/platform-admin/import-worker-process.ts",
    "import-worker:once": "node --experimental-strip-types src/server/platform-admin/import-worker-process.ts --once",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node --experimental-strip-types src/db/check-db-state.ts",
    "db:seed": "node --experimental-strip-types src/db/seed.ts",
    "db:seed:operator": "node --experimental-strip-types src/db/seed-operator.ts",
    "db:link:operator-auth": "node --experimental-strip-types src/db/link-operator-auth.ts",
    "db:link-workspace-member": "node --experimental-strip-types src/db/link-workspace-member.ts",
    "db:studio": "drizzle-kit studio",
    "test": "pnpm run test:node && pnpm run test:vitest",
    "test:node": "node --experimental-strip-types --test tests/*.test.ts",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "test:postgres:owner-guard": "node --experimental-strip-types --test tests/postgres/platformOwnerGuard.integration.test.ts",
    "test:postgres:platform-role-mutations": "node --experimental-strip-types --test tests/postgres/platformRoleMutations.integration.test.ts",
    "test:postgres:platform-suspensions": "node --experimental-strip-types --test tests/postgres/platformSuspensions.integration.test.ts",
    "test:postgres:platform-admin-overview": "node --experimental-strip-types --test tests/postgres/platformAdminOverview.integration.test.ts",
    "test:postgres:platform-admin-imports": "node --experimental-strip-types --test tests/postgres/platformAdminImports.integration.test.ts",
    "test:postgres:import-job-status-expansion": "node --experimental-strip-types --test tests/postgres/importJobStatusExpansion.integration.test.ts",
    "test:postgres:import-job-data-foundation-expand": "node --experimental-strip-types --test tests/postgres/importJobDataFoundationExpand.integration.test.ts",
    "test:postgres:import-job-data-foundation-contract": "node --experimental-strip-types --test tests/postgres/importJobDataFoundationContract.integration.test.ts",
    "test:postgres:import-job-worker-foundation": "node --experimental-strip-types --test tests/postgres/importJobWorkerFoundation.integration.test.ts",
    "test:postgres:import-worker-runtime": "node --experimental-strip-types --test tests/postgres/importWorkerRuntime.integration.test.ts",
    "test:postgres:canonical-session-access": "node --experimental-strip-types --test tests/postgres/canonicalSessionAccess.integration.test.ts",
    "test:postgres:public-event-session-identity": "vitest run --config vitest.public-session-postgres.config.ts",
    "test:postgres:guest-session-queue": "vitest run --config vitest.postgres.config.ts",
    "test:postgres:multi-active-public-events": "vitest run --config vitest.postgres.config.ts",
    "test:e2e:public-event-session-identity-local": "node --experimental-strip-types tests/e2e/run-local-supabase-smoke.ts",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "jsdom": "29.1.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "next-themes": "0.4.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
