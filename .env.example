# For Vercel, use the Supabase transaction pooler connection string.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# Server-only public application origin used for Supabase Auth email redirects.
# Local: http://localhost:3000
# Production: https://poza-nuta.vercel.app
SITE_URL="http://localhost:3000"

OPERATOR_AUTH_USER_ID="00000000-0000-0000-0000-000000000000"
OPERATOR_BOOTSTRAP_NAME="Operator"
OPERATOR_BOOTSTRAP_PIN="change-me"

ISING_API_BASE_URL=https://api.ising.pl/v2
ISING_CLIENT_ID=replace_me
ISING_IMPORT_DELAY_MS=3000
ISING_IMPORT_TAG=
ISING_IMPORT_ORDER=-artist_string
# Optional contact email for internal documentation/logging only.
ISING_IMPORT_CONTACT_EMAIL=
# Optional custom User-Agent. Leave empty to behave like the default runtime/client.
ISING_IMPORT_USER_AGENT=
SONG_INDEX_PATH=data/imports/songs.json
KARAFUN_CSV_PATH=data/sources/karafuncatalog.csv
KARAFUN_IMPORT_REPORT_PATH=data/imports/karafun-import-report.json
API_HOST=0.0.0.0
API_PORT=4321
API_ADMIN_TOKEN=
API_LOG_LEVEL=info
VITE_API_BASE_URL=http://127.0.0.1:4321
